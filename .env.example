# FastAPI & Backend Configuration
GROQ_API_KEY=your_groq_api_key_here
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Supabase Credentials (Use SERVICE_ROLE key for backend database writes)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional OAuth / Server Configuration
uri=http://127.0.0.1:8000
AUTH_REDIRECT_URL=http://localhost:5173
